#include <WiFi.h>
#include <WebServer.h>
#include <HTTPClient.h>
#include <WiFiClientSecure.h>
#include "HX711.h"
#include <ESP32Servo.h>

// WiFi
const char* ssid = "ame";
const char* password = "ame4166288";

// Firebase Realtime Database URL
String firebaseUrl = "https://smart-pet-feeder-9d2a2-default-rtdb.asia-southeast1.firebasedatabase.app";

// Servo
#define SERVO_PIN 14
Servo feederServo;
int servoOpen = 90;
int servoClose = 0;

// HX711
#define DT 4
#define SCK 5
HX711 scale;
float calibration_factor = 1060.0;
const float NOISE_GRAM = 8.0;

// HC-SR04
#define TRIG_PIN 26
#define ECHO_PIN 27
const float TANK_HEIGHT = 17.0;

WebServer server(80);

bool isFeeding = false;
float stopBeforeGram = 3.0;

void allowCORS() {
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.sendHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
  server.sendHeader("Access-Control-Allow-Headers", "Content-Type");
}

void openServo() {
  feederServo.write(servoOpen);
  Serial.println("Servo Open");
}

void closeServo() {
  feederServo.write(servoClose);
  Serial.println("Servo Close");
}

float getWeight() {
  float weight = scale.get_units(20);

  if (weight < 0) weight = 0;
  if (weight < NOISE_GRAM) weight = 0;

  return weight;
}

float readDistanceCM() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000);

  if (duration == 0) {
    Serial.println("HC-SR04 read failed");
    return -1;
  }

  return duration * 0.0343 / 2.0;
}

int calculateFoodPercent(float distance) {
  if (distance < 0) return -1;

  if (distance >= TANK_HEIGHT) return 0;
  if (distance <= 0) return 100;

  float percent = ((TANK_HEIGHT - distance) / TANK_HEIGHT) * 100.0;
  return constrain((int)percent, 0, 100);
}

int getFoodLevelPercent() {
  float distance = readDistanceCM();
  return calculateFoodPercent(distance);
}

void updateFirebaseStatus(float weight, int foodLevel, float distance) {
  if (WiFi.status() != WL_CONNECTED) return;

  WiFiClientSecure client;
  client.setInsecure();

  HTTPClient http;

  String url = firebaseUrl + "/device/status.json";

  String json = "{";
  json += "\"online\":true,";
  json += "\"weight\":" + String(weight, 2) + ",";
  json += "\"foodLevel\":" + String(foodLevel) + ",";
  json += "\"distance\":" + String(distance, 1) + ",";
  json += "\"feeding\":";
  json += isFeeding ? "true" : "false";
  json += "}";

  http.begin(client, url);
  http.addHeader("Content-Type", "application/json");

  int code = http.PUT(json);

  Serial.print("Firebase status code: ");
  Serial.println(code);

  http.end();
}

void resetFirebaseFeed() {
  if (WiFi.status() != WL_CONNECTED) return;

  WiFiClientSecure client;
  client.setInsecure();

  HTTPClient http;

  String url = firebaseUrl + "/device/command/feed.json";

  http.begin(client, url);
  http.addHeader("Content-Type", "application/json");

  int code = http.PUT("false");

  Serial.print("Reset feed code: ");
  Serial.println(code);

  http.end();
}

int getAmountFromPayload(String payload) {
  int amount = 50;

  int index = payload.indexOf("\"amount\":");
  if (index >= 0) {
    String sub = payload.substring(index + 9);
    amount = sub.toInt();
  }

  if (amount < 1) amount = 50;
  if (amount > 300) amount = 300;

  return amount;
}

void checkFirebaseCommand() {
  if (WiFi.status() != WL_CONNECTED) return;
  if (isFeeding) return;

  WiFiClientSecure client;
  client.setInsecure();

  HTTPClient http;

  String url = firebaseUrl + "/device/command.json";

  http.begin(client, url);

  int code = http.GET();

  if (code == 200) {
    String payload = http.getString();

    Serial.print("Firebase command: ");
    Serial.println(payload);

    if (payload.indexOf("\"feed\":true") >= 0) {
      int amount = getAmountFromPayload(payload);

      Serial.println("Firebase Feed Command Received");
      Serial.print("Amount: ");
      Serial.println(amount);

      feedFood(amount);

      resetFirebaseFeed();
    }
  } else {
    Serial.print("Firebase command read failed: ");
    Serial.println(code);
  }

  http.end();
}

void feedFood(float targetGram) {
  if (isFeeding) return;

  isFeeding = true;

  Serial.println("Start Feeding");
  Serial.print("Target: ");
  Serial.print(targetGram);
  Serial.println(" g");

  int foodLevel = getFoodLevelPercent();

  Serial.print("Food Level: ");
  Serial.print(foodLevel);
  Serial.println("%");

  if (foodLevel >= 0 && foodLevel <= 10) {
    Serial.println("Warning: Food level low");
  }

  scale.tare(30);
  delay(300);

  float stopAt = targetGram - stopBeforeGram;
  if (stopAt < 1) stopAt = targetGram;

  openServo();

  unsigned long startTime = millis();
  unsigned long timeout = 20000;

  while (true) {
    float weight = getWeight();

    Serial.print("Weight: ");
    Serial.print(weight, 2);
    Serial.println(" g");

    if (weight >= stopAt) {
      Serial.println("Target reached");
      break;
    }

    if (millis() - startTime > timeout) {
      Serial.println("Timeout");
      break;
    }

    delay(100);
  }

  closeServo();

  Serial.println("Feeding Done");

  isFeeding = false;

  float distance = readDistanceCM();
  int percent = calculateFoodPercent(distance);
  float weight = getWeight();

  updateFirebaseStatus(weight, percent, distance);
}

void handleStatus() {
  allowCORS();

  String json = "{";
  json += "\"status\":\"online\",";
  json += "\"feeding\":";
  json += isFeeding ? "true" : "false";
  json += "}";

  server.send(200, "application/json", json);
}

void handleLevel() {
  allowCORS();

  float distance = readDistanceCM();
  int level = calculateFoodPercent(distance);

  String json = "{";
  json += "\"distance_cm\":";
  json += String(distance, 1);
  json += ",";
  json += "\"level\":";
  json += String(level);
  json += ",";
  json += "\"food_percent\":";
  json += String(level);
  json += "}";

  server.send(200, "application/json", json);
}

void handleWeight() {
  allowCORS();

  float weight = getWeight();

  String json = "{";
  json += "\"weight\":";
  json += String(weight, 2);
  json += "}";

  server.send(200, "application/json", json);
}

void handleFeed() {
  allowCORS();

  float amount = 50;

  if (server.hasArg("amount")) {
    amount = server.arg("amount").toFloat();
  }

  feedFood(amount);

  server.send(200, "text/plain", "Feed success");
}

void handleOpen() {
  allowCORS();
  openServo();
  server.send(200, "text/plain", "Servo opened");
}

void handleClose() {
  allowCORS();
  closeServo();
  server.send(200, "text/plain", "Servo closed");
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("Smart Pet Feeder Firebase Start");

  feederServo.attach(SERVO_PIN);
  closeServo();
  Serial.println("Servo Ready");

  scale.begin(DT, SCK);
  scale.set_scale(calibration_factor);

  Serial.println("Put EMPTY bowl on Load Cell");
  Serial.println("Tare in 5 seconds...");
  delay(5000);

  scale.tare(30);

  Serial.println("Tare Complete");
  Serial.println("Bowl = 0 g");
  Serial.println("HX711 Ready");

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  Serial.println("HC-SR04 Ready");

  WiFi.begin(ssid, password);
  Serial.print("Connecting WiFi");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi connected");
  Serial.print("ESP32 IP: ");
  Serial.println(WiFi.localIP());

  server.on("/status", handleStatus);
  server.on("/level", handleLevel);
  server.on("/weight", handleWeight);
  server.on("/feed", handleFeed);
  server.on("/open", handleOpen);
  server.on("/close", handleClose);

  server.begin();
  Serial.println("Server started");

  float distance = readDistanceCM();
  int percent = calculateFoodPercent(distance);
  float weight = getWeight();

  updateFirebaseStatus(weight, percent, distance);
}

void loop() {
  server.handleClient();

  static unsigned long lastFirebase = 0;

  if (millis() - lastFirebase >= 3000) {
    float distance = readDistanceCM();
    int percent = calculateFoodPercent(distance);
    float weight = getWeight();

    Serial.print("Distance: ");
    Serial.print(distance, 1);
    Serial.print(" cm | Food Level: ");
    Serial.print(percent);
    Serial.print("% | Weight: ");
    Serial.print(weight, 2);
    Serial.println(" g");

    updateFirebaseStatus(weight, percent, distance);
    checkFirebaseCommand();

    lastFirebase = millis();
  }
}
