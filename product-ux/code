  String petName = 'Lucky';
  String deviceName = 'Smart Feeder 01';
  String esp32Ip = '192.168.1.10';

  int foodLevel = 75;
  double foodAmount = 50;

  final List<FeedSchedule> schedules = [
    FeedSchedule(time: const TimeOfDay(hour: 8, minute: 0), amount: 50),
    FeedSchedule(time: const TimeOfDay(hour: 18, minute: 0), amount: 80),
