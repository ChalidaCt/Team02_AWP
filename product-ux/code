                    min: 10,
                    max: 1000,
                    divisions: 99,
                    label: '${tempAmount.toInt()} กรัม',
                    activeColor: Colors.orange,
                    onChanged: (value) {
                      setDialogState(() {
                        tempAmount = value;
                      });
                    },
                  ),
                  const Text('เลือกปริมาณ 10 - 1000 กรัม'),
                ],
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(context),
                  child: const Text('ยกเลิก'),
