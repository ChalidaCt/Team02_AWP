  String showTime(TimeOfDay time) {
    return '${time.hour.toString().padLeft(2, '0')}:${time.minute.toString().padLeft(2, '0')} น.';
  }

  void feedNow() {
    setState(() {
      history.insert(0, 'ให้อาหารตอนนี้ ${foodAmount.toInt()} กรัม');
      foodLevel = foodLevel >= 10 ? foodLevel - 10 : 0;
    });

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('ให้อาหาร ${foodAmount.toInt()} กรัมแล้ว')),
    );
  }

  Future<void> addSchedule() async {
    final time = await showTimePicker(
