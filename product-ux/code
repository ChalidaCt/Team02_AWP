      initialTime: const TimeOfDay(hour: 8, minute: 0),
    );

    if (time == null) return;

    double tempAmount = foodAmount;

    showDialog(
      context: context,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            return AlertDialog(
              title: const Text('เพิ่มเวลาให้อาหาร'),
              content: Column(
