#include <WiFi.h>
#include <ESP32Servo.h>

Servo feederServo;

const int servoPin = 13;

void setup() {
  Serial.begin(115200);

  feederServo.attach(servoPin);
  feederServo.write(0);

  Serial.println("Pet Feeder System Ready");
}

void loop() {
  // จำลองการกดปุ่ม Feed
  Serial.println("Feeding...");
  
  feederServo.write(90); // หมุนปล่อยอาหาร
  delay(2000);

  feederServo.write(0); // กลับตำแหน่งเดิม
  delay(3000);

  Serial.println("Feeding Success");
}
